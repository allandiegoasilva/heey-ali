{
  "compilerOptions": {
    "target": "ES2023",                                  
    "module": "commonjs",                                
    "baseUrl": "./",                                  
    "outDir": "./dist",                                  
    "esModuleInterop": true,                            
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                      
    "skipLibCheck": true,
    "paths": {
      "@/*": ["src/*"],
    }
  }
}
